{
  "id": "obs",
  "nome": "OBS",
  "versao": "0.2.0",
  "autor": "valb-mig",
  "repositorio": "https://github.com/ato20-org/ato20.obs.plugin",
  "descricao": "Leva a mesa para a live: os dados caindo e os retratos dos personagens, em fontes de navegador com fundo transparente.",
  "apiVersao": 3,
  "principal": "main.js",
  "ativacao": "abertura",
  "contribui": {
    "paineis": [
      {
        "id": "transmissao",
        "titulo": "Transmissão",
        "subtitulo": "Os dados e os retratos na live"
      }
    ],
    "paginas": [
      {
        "id": "camera",
        "titulo": "Câmera dos dados",
        "arquivo": "camera.html"
      },
      {
        "id": "retratos",
        "titulo": "Retratos",
        "arquivo": "retratos.html"
      }
    ],
    "configuracoes": [
      {
        "chave": "obs.ocultos",
        "titulo": "Quem não aparece na live",
        "descricao": "Editado pelo painel Transmissão.",
        "tipo": "lista",
        "padrao": [
          "mestre"
        ],
        "escopo": "campanha"
      },
      {
        "chave": "obs.prazo",
        "titulo": "Segundos que o dado fica na live",
        "descricao": "Depois de o dado parar.",
        "tipo": "numero",
        "padrao": 10,
        "minimo": 1,
        "maximo": 600
      },
      {
        "chave": "obs.nome",
        "titulo": "Escrever quem jogou",
        "descricao": "O nome aparece embaixo de cada dado.",
        "tipo": "booleano",
        "padrao": false
      }
    ]
  }
}
